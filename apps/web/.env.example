# Clean E-yAy web (Next.js) — local dev env örneği.
# Kullanım: bu dosyayı `apps/web/.env.local` olarak kopyala.

# API base URL. Default: http://127.0.0.1:8000
# Eski isim (NEXT_PUBLIC_API_BASE) hâlâ desteklenir (fallback).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Public app sürüm tag (banner'da gösterilir, ops için).
# NEXT_PUBLIC_APP_TAG=clean-eyay-dev
