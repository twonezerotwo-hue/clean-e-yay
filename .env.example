# Clean E-yAy — environment örneği.
#
# Bu dosya DOKÜMANTASYONDUR. Lokal dev'de LLM katmanı root .env'i set edilmemiş
# değişkenler için okuyabilir; prod'da shell/compose/launchd/systemd üzerinden export et.
# Hepsinin makul bir default'u var; hiçbiri zorunlu değil (LLM provider'ları isteğe bağlı).
# Çoğu yol değişkeni yalnızca prod'da kalıcı volume hedeflemek için gerekir.

# ── API / CORS ────────────────────────────────────────────────────────────
# DEV_CORS=true → tüm origin'lere izin (yalnızca local dev). Default: whitelist
# (127.0.0.1:4000 + localhost:4000). Ek origin için virgüllü liste:
DEV_CORS=false
CORS_EXTRA_ORIGINS=

# ── LLM persona (yalnızca ANLATIM; karar VERMEZ) ──────────────────────────
# LLM_MODE: off | mock | groq | openrouter | ollama.
# Set değilse: OPENROUTER_API_KEY varsa openrouter, GROQ_API_KEY varsa groq,
# yoksa off.
# ollama modunda önce local Ollama denenir; çalışmazsa OPENROUTER/GROQ anahtarı
# varsa remote fallback, yoksa deterministik fallback çalışır.
# Anahtar yoksa/hata olursa sistem network'süz deterministik fallback ile çalışır.
LLM_MODE=off
LLM_LOAD_DOTENV=true
OLLAMA_API_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=llama3.1:8b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=~openai/gpt-latest
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Clean E-yAy
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_DAILY_TOKEN_BUDGET=1000000
LLM_MAX_TOKENS_PER_REQUEST=2000
LLM_CACHE_TTL_SEC=7200

# ── Live web search for chat (read-only; karar motoruna veri yazmaz) ───────────
# Katman 0 sohbeti "son dakika", "Trump ne dedi", "İsrail haberi var mı" gibi
# güncel kamu/haber sorularında backend proxy üzerinden Tavily araması yapabilir.
# Anahtar frontend'e sızmaz; yoksa mevcut backend haber/state cevabına düşer.
TAVILY_API_KEY=
TAVILY_SEARCH_URL=https://api.tavily.com/search
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5
TAVILY_LOAD_DOTENV=true

# ── Voice / TTS (yalnızca anlatım; karar motoruna bağlı değildir) ──────────
# Frontend API key görmez. Web /api/voice/speak çağırır; backend provider'a
# proxy eder. İlk provider: elevenlabs. Anahtar yoksa endpoint 503 döner.
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ── Data providers ────────────────────────────────────────────────────────
# FRED — Federal Reserve Economic Data. Opsiyonel makro/Fed serileri için.
# Anahtar yoksa provider 'disabled' olarak işaretlenir (degraded DEĞİL —
# /api/v1/system/health'i yeşil tutar). Set edersen makro seriler aktifleşir.
# Ücretsiz signup (1 dakika): https://fredaccount.stlouisfed.org/apikeys
# Diğer provider'lar (CoinGecko/Yahoo/RSS/Deribit/Binance) anahtarsız public.
FRED_API_KEY=

# ── Mode flags (YAPISAL — kodda zorlanır; bu env'ler davranışı DEĞİŞTİRMEZ) ──
# Güvenlik kodda yapısal: /system/health paper_safe=true, no_execution=true
# (sabit). Aşağıdakiler yalnızca niyeti belgeler — prod'da ASLA gevşetme.
PAPER_ONLY=true
NO_EXECUTION=true
REPLAY_ONLY=false
# Runtime mock fallback YASAK. true yapılırsa dashboard kırmızı "MOCK MODE"
# banner gösterir; prod'da KULLANMA.
PRICE_USE_MOCK=false

# ── Runtime state yolları (prod: kalıcı volume hedefle) ───────────────────
# Default'ların hepsi data/runtime/ altında (gitignored). Prod'da bu dizini
# kalıcı bir volume'a mount et; tek tek override de edilebilir:
SNAPSHOT_STORE_PATH=data/runtime/snapshots
SNAPSHOT_STORE_MAX=500
PAPER_STATE_PATH=data/runtime/paper_state.json
PAPER_AUDIT_PATH=data/runtime/paper_audit.jsonl
DECISION_LOG_PATH=data/runtime/decision_log.jsonl
RISK_HALT_PATH=data/runtime/risk_halts.json
WORKER_HEARTBEAT_PATH=data/runtime/worker_heartbeats.json
LEARNING_RUN_PATH=data/runtime/learning_run.json
LEARNING_OUT_PATH=data/runtime/learning_summary.json
CALIBRATION_STORE_PATH=data/runtime/calibration.json
REBALANCE_STORE_PATH=data/runtime/rebalance.json
LLM_BUDGET_PATH=data/runtime/llm_budget.json
LLM_CACHE_PATH=data/runtime/llm_cache.json
OHLCV_CACHE_DIR=data/runtime/ohlcv

# ── Worker ────────────────────────────────────────────────────────────────
# tick_worker: uzun-ömürlü daemon (bu aralıkta döner). learning_worker:
# tek-seferlik (run_once) — 7/24 için zamanlayıcıyla (cron/timer) çalıştır,
# restart-always KULLANMA (spin-loop yapar).
TICK_INTERVAL_SEC=30

# ── SSL (live provider'lar) ───────────────────────────────────────────────
# Bazı Python kurulumlarında sistem CA zinciri yok → CERTIFICATE_VERIFY_FAILED.
# certifi kuruluysa: SSL_CERT_FILE="$(python -m certifi)". make api-dev ve
# scripts/dev.sh bunu otomatik ayarlar.
# SSL_CERT_FILE=/path/to/certifi/cacert.pem

# ── Frontend (apps/web/.env.local) ────────────────────────────────────────
# Birincil isim; eski NEXT_PUBLIC_API_BASE hâlâ fallback olarak okunur.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:9000
# NEXT_PUBLIC_APP_TAG=clean-eyay-rc

# ── Test/dev yalnızca (prod'da ASLA set etme) ─────────────────────────────
# conftest test session boyunca TEST_USE_MOCK=true set eder; mock quote'lar
# verified=false/status=MOCK damgalı. Provider bazlı fixture flag'leri:
# TEST_USE_MOCK / OHLCV_USE_FIXTURE / NEWS_USE_FIXTURE / CALENDAR_USE_FIXTURE /
# DERIVATIVES_USE_FIXTURE / OPTIONS_USE_FIXTURE.
